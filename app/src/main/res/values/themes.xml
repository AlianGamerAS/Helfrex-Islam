    <style name="Theme.App.NeonEmerald" parent="Theme.MyApplication">
        <item name="android:windowBackground">@color/splash_bg_neon_emerald_dark</item>
        <item name="android:statusBarColor">@color/splash_bg_neon_emerald_dark</item>
        <item name="android:navigationBarColor">@color/nav_bar_neon_emerald_dark</item>
    </style>

    <style name="Theme.App.NeonEmeraldLight" parent="Theme.MyApplication">
        <item name="android:windowBackground">@color/splash_bg_neon_emerald_light</item>
        <item name="android:statusBarColor">@color/splash_bg_neon_emerald_light</item>
